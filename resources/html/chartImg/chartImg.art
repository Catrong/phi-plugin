{{extend defaultLayout}}
{{block 'css'}}
    <link rel="stylesheet" href="{{_res_path}}html/chartImg/chartImg.css">
    {{if theme != 'star' && (!themeInfo || !themeInfo.backgroundUrl)}}
    <style>
        /* 本页已有曲绘背景，避免重复绘制整页模糊背景。 */
        .theme-background { display: none; }
    </style>
    {{/if}}
    {{if renderNoJs}}
    <style>
        /* 静态 SVG 与文本参与布局，信息较多时面板按实际内容增长。 */
        .chart-info { height: auto; min-height: 500px; }
        .chart-info > .box-content, .chart-info .info-content { height: auto; }
        .chart-info .info-box, .chart-info .words-box, .chart-info .notes-bar { height: auto; min-width: 0; }
        .chart-info .info-box .content p { overflow-wrap: anywhere; }
        .chart-info .notes-content p { white-space: nowrap; }
        .chart-info .words { position: static; width: 100%; height: 430px; }
        .chart-info .box-tip { position: static; align-self: flex-end; margin: 8px 0 12px; }
        .chart-info .box-tip p { font-size: 36px; }
        .chart-info .bar-box { height: 350px; flex: none; }
    </style>
    {{/if}}
{{/block}}
{{block 'main'}}
    <div class="background{{if illustrationPreBlurred && (!themeInfo || !themeInfo.cssUrl)}} chart-background-preblurred{{/if}}">
        <img src="{{illustration}}" alt="曲绘-模糊">
    </div>
    <div class="backBlock">
        <div class="totalBox" id="box">
            <img src="{{chartImg}}" alt="谱面预览">
        </div>
    </div>
    <div class="chart-info">
        <div class="box-content dot-box">
            <div class="dot left top"></div>
            <div class="dot left bottom"></div>
            <div class="dot right top"></div>
            <div class="dot right bottom"></div>
            <div class="info-content">
                <div class="info-box{{charterReal ? ' has-charter' : ''}}">
                    <div class="content-title">
                        <p>Basic Information</p>
                    </div>
                    <div class="content">
                        <p>曲目 {{song}}</p>
                        <p>时长 {{length}}</p>
                        <p>难度 {{rank}} {{difficulty}}</p>
                        <p>谱师 {{charter}}</p>
                        {{if charterReal}}
                        <p class="charter-real">（{{charterReal}}）</p>
                        <p class="charter-source">谱师名录来源于 daogemm.github.io，按字典序排列</p>
                        {{/if}}
                    </div>
                </div>
                <div class="notes-box">
                    <div class="content-title">
                        <p>Notes</p>
                    </div>
                    <div class="content">
                        <div class="notes-content tap-p">
                            <p>{{tap}}</p>
                            <p>Tap</p>
                        </div>
                        <div class="notes-content drag-p"> 
                            <p>{{drag}}</p>
                            <p>Drag</p>
                        </div>
                        <div class="notes-content hold-p">
                            <p>{{hold}}</p>
                            <p>Hold</p>
                        </div>
                        <div class="notes-content flick-p">
                            <p>{{flick}}</p>
                            <p>Flick</p>
                        </div>
                        <div class="notes-content">
                            <p>{{combo}}</p>
                            <p>Combo</p>
                        </div>
                    </div>
                </div>
                <div class="words-box">
                    <div class="content-title">
                        <p>Chart Tag</p>
                    </div>
                    <div class="box-tip">
                        <p>维度标签体系参考自 @空游小站（kyou.net.cn）</p>
                    </div>
                    <div class="words" id="words">
                        <div class="tag-detail-layout">
                            <div class="tag-radar-preview">
                                {{@ staticCharts.radar(words, wordsMaxValue, { width: 420, height: 420, fontSize: 30 })}}
                            </div>
                            <div class="tag-category-list">
                                {{each tagCategories category}}
                                <div class="tag-category tag-category-{{category.key}}">
                                    <div class="tag-category-name">{{category.name}}</div>
                                    <p class="tag-category-items">{{each category.children child childIndex}}{{if childIndex}}、{{/if}}{{child.name}}({{child.value}}){{/each}}</p>
                                </div>
                                {{/each}}
                                {{if !tagCategories.length}}
                                <p class="tag-category-empty">暂无谱面标签</p>
                                {{/if}}
                            </div>
                        </div>
                    </div>
                </div>
                <div class="notes-bar">
                    <div class="content-title">
                        <p>Notes Distribution</p>
                    </div>
                    <div class="box-tip">
                        <p>谱面时长：{{chartLength}}</p>
                    </div>
                    <div class="bar-box" id="bar-box">
                        {{each distribution e}}
                        <div class="bar" style="height: {{e[4]}}%">
                            <div
                                class="bar-item TAP-BKG"
                                style="height: {{e[0]}}%"
                            ></div>
                            <div
                                class="bar-item DRAG-BKG"
                                style="height: {{e[1]}}%"
                            ></div>
                            <div
                                class="bar-item HOLD-BKG"
                                style="height: {{e[2]}}%"
                            ></div>
                            <div
                                class="bar-item FLICK-BKG"
                                style="height: {{e[3]}}%"
                            ></div>
                        </div>
                        {{/each}}
                    </div>
                </div>
            </div>
        </div>
    </div>
{{/block}}
