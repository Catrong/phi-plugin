{{extend defaultLayout}}
{{block 'css'}}
<link rel="stylesheet" href="{{_res_path}}html/setting/setting.css">
{{if renderNoJs}}
<style>
    .setting-expanded { min-height: 50px; }
    .setting-expanded .square { flex-shrink: 0; }
    .setting-expanded .left { flex: 1; min-width: 0; padding: 7px 8px 7px 0; }
    .setting-expanded .title { height: auto; }
    .setting-expanded .left p { white-space: normal; overflow-wrap: anywhere; }
    .setting-expanded .right { position: relative; right: auto; height: auto; min-width: 0; width: 180px; flex-shrink: 0; margin-right: 12px; }
    .setting-expanded .space.setting-value { width: 140px; height: auto; min-height: 25px; box-sizing: border-box; padding: 5px 14px; }
    .setting-expanded .space.setting-value p { width: 100%; white-space: normal; overflow-wrap: anywhere; text-align: center; }
</style>
{{/if}}
{{/block}}

{{block 'main'}}
<div class="background">
    {{if theme == "star"}}
    <img src="{{_res_path}}html/otherimg/Star1.png" alt="曲绘-模糊">
    <img src="{{_res_path}}html/otherimg/Star2.png" alt="曲绘-模糊"
        style="min-height: 0;width: 100%;height: auto;bottom: 0;filter: none;">
    {{else}}
    {{if background}}
    <img src="{{background}}" alt="曲绘-模糊">
    {{else}}
    <img src="{{_res_path}}html/otherimg/phigros.png" alt="曲绘-模糊">
    {{/if}}
    {{/if}}
</div>
<div class="big-title">
    <p>Phi-Plugin 控制面板</p>
</div>
<div class="box">
    {{each data as value}}
    <div class="lineBox{{value.type == "divider"?" divider":''}}">
        {{set valueOptions = ({ breakWords: true, useFontMetrics: !(themeInfo && themeInfo.fontUrl) })}}
        {{set expandedValue = renderNoJs && value.type == 'space' && typeof staticText !== 'undefined' && (staticText.fitPvis ? staticText.fitPvis(value.value, 65, 25, 15, 1, valueOptions) : staticText.fitLine(value.value, 65, 15, 1)) < 12}}
        <div class="line{{expandedValue ? ' setting-expanded' : ''}}">
            <div class="square"></div>
            <div class="left">
                <div class="title">
                    <p>{{value.label}}</p>
                </div>
                <div class="info">
                    <p>{{value.bottomHelpMessage}}</p>
                </div>
            </div>
            <div class="right">
                {{if value.type == "space"}}
                <div class="space{{renderNoJs ? ' setting-value' : ''}}">
                    <p name="pvis"{{if renderNoJs && !expandedValue && typeof staticText !== 'undefined'}} style="font-size: {{staticText.fitPvis ? staticText.fitPvis(value.value, 65, 25, 15, 12, valueOptions) : staticText.fitLine(value.value, 65, 15, 12)}}px"{{/if}}>{{value.value}}</p>
                </div>
                <div class="drc">
                    <p>{{value.drc}}</p>
                </div>
                {{else if value.type == "switch"}}
                <div class="space">
                    {{if value.value == true}}
                    <div class="switchDrc-true">
                        <p>ON</p>
                    </div>
                    <div class="switch-true"></div>
                    {{else}}
                    <div class="switch-false"></div>
                    <div class="switchDrc-false">
                        <p>OFF</p>
                    </div>
                    {{/if}}
                </div>
                {{/if}}
            </div>
        </div>
    </div>
    {{/each}}
</div>
<div class="createdbox">
    <div class="phi-plugin">
        <p>{{_plugin}}</p>
    </div>
    <div class="ver">
        <p>{{Version.ver}}</p>
    </div>
</div>
{{/block}}
