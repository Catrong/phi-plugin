{{extend defaultLayout}}
{{block 'css'}}
<link rel="stylesheet" href="{{_res_path}}html/market/market.css">
{{/block}}

{{block 'main'}}
<main class="market-page detail-page">
    <header class="detail-header">
        <a class="back-link" href="#">主题市场</a>
        <span class="detail-slug">{{detail.slug}}</span>
    </header>
    <section class="detail-hero">
        {{if detail.cover}}
        <img class="detail-cover" src="{{detail.cover}}" alt="{{detail.name}}">
        {{else}}
        <div class="detail-cover cover-fallback"><span>{{detail.name.slice(0, 1)}}</span></div>
        {{/if}}
        <div class="detail-intro">
            <p class="eyebrow">THEME DETAILS</p>
            <h1>{{detail.name}}</h1>
            <p class="detail-author">by {{detail.author || '社区作者'}} · v{{detail.version || '--'}}</p>
            <p class="detail-description">{{detail.description || detail.summary || '暂无详细介绍。'}}</p>
            <div class="tags">
                {{each detail.tags as tag}}<span>{{tag}}</span>{{/each}}
            </div>
        </div>
    </section>
    <section class="detail-stats">
        <div><span>下载量</span><strong>{{detail.downloads}}</strong></div>
        <div><span>兼容性</span><strong>{{detail.compatibility || '以最新插件为准'}}</strong></div>
        <div><span>下载策略</span><strong>{{detail.downloadPolicy === 'public' ? '公开' : 'Bot 授权'}}</strong></div>
        <div><span>更新时间</span><strong>{{detail.updatedAt || '--'}}</strong></div>
    </section>
    {{if detail.releaseNotes}}
    <section class="release-notes">
        <h2>更新说明</h2>
        <p>{{detail.releaseNotes}}</p>
    </section>
    {{/if}}
</main>
{{/block}}
