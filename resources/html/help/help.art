{{extend defaultLayout}}
{{block 'css'}}

<link rel="stylesheet" href="{{_res_path}}html/help/help.css">
{{if renderNoJs}}
<style>
    .help_box { align-items: stretch; }
    .line { height: auto; min-height: 121px; }
    .order { height: auto; padding: 6px; }
    .order p { font-size: 23px; line-height: 1.25; white-space: normal; overflow-wrap: anywhere; }
    .info_box { height: auto; min-width: 0; }
    .up { height: auto; min-height: 25px; align-items: stretch; white-space: normal; }
    .num { height: auto; flex-shrink: 0; }
    .song { height: auto; min-width: 0; padding-top: 3px; padding-bottom: 3px; }
    .song p { font-size: 16px; line-height: 1.25; white-space: normal; overflow-wrap: anywhere; }
    .down { height: auto; min-height: 90px; flex: 1; }
    .desc { height: auto; align-items: flex-start; }
    .desc p { font-size: 15px; line-height: 1.35; white-space: normal; overflow-wrap: anywhere; }
    .desc img { max-width: 100%; height: auto; }
</style>
{{/if}}

{{/block}}
{{block 'main'}}

    
    {{each helpGroup group}}
    {{if group.auth!="master"||isMaster}}
    {{set len = group?.list?.length || 0 }}
    <div class="help_box">
        <div class="help-group">——·{{group.group}}·——</div>
        {{if len > 0}}
        {{each group.list help idx}}
        <div class="line">
            <div class="order">
                {{if cmdHead}}
                <p name="pvis">{{#help.title.replace(/[\/杠钢刚]/g,`/${cmdHead} `)}}</p>
                {{else}}
                <p name="pvis">{{#help.title}}</p>
                {{/if}}
            </div>
            <div class="info_box">
                <div class="up">
                    <div class="num">{{idx + 1}}</div>
                    <div class="song">
                        {{if cmdHead}}
                        <p name="pvis">{{#(help.eg || help.title).replace(/[\/杠钢刚]/g,`/${cmdHead} `)}}</p>
                        {{else}}
                        <p name="pvis">{{#(help.eg || help.title)}}</p>
                        {{/if}}
                    </div>
                    <!-- <div class="Master">Master</div> -->
                </div>
                <div class="down">
                    <div class="desc">
                        {{if help.desc}}
                        <p name="pvis">{{#help.desc.replace(/\s/g,'&ensp;')}}</p>
                        {{/if}}
                        {{if help.img}}
                        <img src="{{_res_path}}html/otherimg/{{help.img}}" alt="{{help.img}}">
                        {{/if}}
                    </div>
                </div>
            </div>
        </div>
        {{/each}}
        {{/if}}
    </div>
    {{/if}}
    {{/each}}

    <div class="createdbox">
        <div class="phi-plugin">
            <p>{{_plugin}}</p>
        </div>
        <div class="ver">
            <p>{{Version.ver}}</p>
        </div>
    </div>
    <div class="copyright">
        <p>*Phi-Plugin不是Phigros官方项目，与南京鸽游网络有限公司及Phigros官方不存在授权、合作或运营关系。
        </p>
    </div>
    
    {{if theme == "snow"}}
    <div class="snow-box"> </div>
    <script>
        themeSnow();
    </script>
    {{else if theme == "topText" || theme == "foolsDay"}}
    <div class="topTextBox" id="topTextBox"></div>
    <script>
        themeTopText();
    </script>
    {{else if theme == "star"}}
    <canvas id="stars"></canvas>
    <script>
        themeStar();
    </script>
    {{/if}}
{{/block}}
