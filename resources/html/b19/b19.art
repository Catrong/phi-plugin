{{extend defaultLayout}}

{{block 'css'}}
{{if themeInfo && themeInfo.cssUrl && themeInfo.cssMode == "replace"}}
<link rel="stylesheet" href="{{themeInfo.cssUrl}}">
{{else}}
<link rel="stylesheet" href="{{_res_path}}html/b19/b19.css">
{{/if}}
{{/block}}

{{block 'main'}}

<div class="title">
    <div class="playerInfo">
        <div class="blackBlock clip-box"></div>
        <div class="avatar clip-box">
            <img src="{{_res_path}}html/avatar/{{gameuser.avatar}}.png" alt="{{gameuser.avatar}}">
        </div>
        <div class="playerId">
            <p name="pvis">{{#gameuser.PlayerId}}</p>
        </div>
        <div class="rks clip-box">
            <p>{{gameuser.rks.toFixed(4)}}</p>
        </div>
        <div class="clgBox">
            <div class="Challenge">
            <img src="{{_res_path}}html/otherimg/{{gameuser.ChallengeMode}}.png" alt="Challenge">
            <p>{{gameuser.ChallengeModeRank}}</p>
            </div>
        </div>
        <div class="date">
            <p>{{Date}}</p>
        </div>
        <div class="dataBox clip-box">
            <img src="{{_res_path}}html/otherimg/data.png" alt="data">
            <p>{{gameuser.data}}</p>
        </div>
        {{if spInfo}}
        <div class="spInfoBox">
            {{each spInfo v}}
            <div class="spInfo colorful-background clip-box">
                <p>{{v}}</p>
            </div>
            {{/each}}
        </div>
        {{/if}}
    </div>
    <div class="recordInfo clip-box">
        <div class="whiteLine clip-box"></div>
        <div class="sheet">
            <div class="row">
                <div class="poz">
                    <p>\</p>
                </div>
                {{each stats v i}}
                <div class="poz">
                    <p>{{v.title}}</p>
                </div>
                {{/each}}
            </div>
            <div class="row">
                <div class="poz">
                    <p>C</p>
                </div>
                {{each stats v i}}
                <div class="poz">
                    <p>{{v.cleared}}</p>
                </div>
                {{/each}}
            </div>
            <div class="row">
                <div class="poz">
                    <p>FC</p>
                </div>
                {{each stats v i}}
                <div class="poz">
                    <p>{{v.fc}}</p>
                </div>
                {{/each}}
            </div>
            <div class="row">
                <div class="poz">
                    <p>Phi</p>
                </div>
                {{each stats v i}}
                <div class="poz">
                    <p>{{v.phi}}</p>
                </div>
                {{/each}}
            </div>
        </div>
    </div>
</div>
<div class="b19">
    {{if phi}}

    {{each phi song}}

    {{if song}}


    <div class="song phi_song">
        <div class="ill-box">
            <div class="num clip-box">
                <p name="pvis">P{{$index+1}}</p>
            </div>
            <div class="ill clip-box">
                <img src="{{song.illustration}}" alt="ill">
            </div>
            <div class="rank-{{song.rank}} clip-box">
                <div class="org">
                    <p>{{song.rank}}&ensp;{{song.difficulty.toFixed(1)}}</p>
                </div>
                <div class="rel">
                    <p>{{song.rks.toFixed(2)}}</p>
                </div>
            </div>
        </div>
        <div class="info-{{song.rank}}">
            <div class="songname">
                <p name="pvis">{{song.song}}</p>
            </div>
            <div class="songinfo">
                <div class="Rating">
                    <img src="{{themeInfo && themeInfo.icons && themeInfo.icons[song.Rating] ? themeInfo.icons[song.Rating] : (_res_path + 'html/otherimg/' + song.Rating + '.png')}}" alt="{{song.Rating}}">
                </div>
                <div class="chengji">
                    <div class="score">
                        <p>{{song.score}}</p>
                    </div>
                    <div class="line"></div>
                    <div class="acc-box">
                        <div class="acc">
                            <p>{{song.acc.toFixed(2)}}%</p>
                        </div>
                        <div class="suggest suggest-kind-{{song.suggestType}}">
                            <div class="suggest-tip"></div>
                            <p>{{song.suggest}}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {{if song.accAvg}}
        <div class="accAvg acc{{song.accKind}} clip-box">
            <div class="accAvgLine clip-box"></div>
            <svg viewBox="0 0 1024 1024">
            {{if song.accKind == 'Finished'}}
            <path
            d="M892.064 261.888a31.936 31.936 0 0 0-45.216 1.472L421.664 717.248l-220.448-185.216a32 32 0 1 0-41.152 48.992l243.648 204.704a31.872 31.872 0 0 0 20.576 7.488 31.808 31.808 0 0 0 23.36-10.112L893.536 307.136a32 32 0 0 0-1.472-45.248z"
            p-id="5526"
            ></path>
            {{else}}
            <path
                d="M564.8 465.184l4.192 3.904 274.72 274.752a32 32 0 0 1 0 45.248l-22.624 22.624a32 32 0 0 1-45.248 0l-263.456-263.392-263.424 263.392a32 32 0 0 1-42.24 2.656l-3.008-2.656-22.624-22.624a32 32 0 0 1 0-45.248l274.784-274.752a80 80 0 0 1 108.96-3.904z m0-256l4.192 3.904 274.72 274.752a32 32 0 0 1 0 45.248l-22.624 22.624a32 32 0 0 1-45.248 0l-263.456-263.392-263.424 263.392a32 32 0 0 1-42.24 2.656l-3.008-2.656-22.624-22.624a32 32 0 0 1 0-45.248l274.784-274.752a80 80 0 0 1 108.96-3.904z"
                fill="#333333"
                p-id="1589"
            ></path>
            {{/if}}
            </svg>
            <p>Avg: {{song.accAvg.toFixed(4)}}%</p>
        </div>
        {{/if}}
        {{if song.cpToOld}}
        <div class="cpToOld acc{{song.cpToOld.type}} clip-box-left">
            <p>Dif</p>
            <svg viewBox="0 0 1024 1024">
            <path
                d="M564.8 465.184l4.192 3.904 274.72 274.752a32 32 0 0 1 0 45.248l-22.624 22.624a32 32 0 0 1-45.248 0l-263.456-263.392-263.424 263.392a32 32 0 0 1-42.24 2.656l-3.008-2.656-22.624-22.624a32 32 0 0 1 0-45.248l274.784-274.752a80 80 0 0 1 108.96-3.904z m0-256l4.192 3.904 274.72 274.752a32 32 0 0 1 0 45.248l-22.624 22.624a32 32 0 0 1-45.248 0l-263.456-263.392-263.424 263.392a32 32 0 0 1-42.24 2.656l-3.008-2.656-22.624-22.624a32 32 0 0 1 0-45.248l274.784-274.752a80 80 0 0 1 108.96-3.904z"
                fill="#333333"
                p-id="1589"
            ></path>
            </svg>
            <p>{{song.cpToOld.dif}}&ensp;&ensp;&ensp;RKS</p>
            <svg viewBox="0 0 1024 1024">
            <path
                d="M564.8 465.184l4.192 3.904 274.72 274.752a32 32 0 0 1 0 45.248l-22.624 22.624a32 32 0 0 1-45.248 0l-263.456-263.392-263.424 263.392a32 32 0 0 1-42.24 2.656l-3.008-2.656-22.624-22.624a32 32 0 0 1 0-45.248l274.784-274.752a80 80 0 0 1 108.96-3.904z m0-256l4.192 3.904 274.72 274.752a32 32 0 0 1 0 45.248l-22.624 22.624a32 32 0 0 1-45.248 0l-263.456-263.392-263.424 263.392a32 32 0 0 1-42.24 2.656l-3.008-2.656-22.624-22.624a32 32 0 0 1 0-45.248l274.784-274.752a80 80 0 0 1 108.96-3.904z"
                fill="#333333"
                p-id="1589"
            ></path>
            </svg>
            <p>{{song.cpToOld.rks}}</p>
        </div>
        {{/if}}
    </div>

    {{else}}

    <div class="Nosignal">
        <div class="border_corner border_corner_left_top"></div>
        <div class="border_corner border_corner_right_top"></div>
        <div class="border_corner border_corner_left_bottom"></div>
        <div class="border_corner border_corner_right_bottom"></div>
        <div class="line"></div>
        <div class="timeout">
            <p>TIME_OUT</p>
        </div>
        <div class="client">
            <p>>>> PhigrOS Client Finding Phi.score</p>
        </div>
        <div class="sqrt"></div>
    </div>

    {{/if}}

    {{/each}}

    {{/if}}


    {{each b19_list song}}
    
    {{if $index == (phi ? 27 : 30)}}
    <div class="over_flow">
        <div class="flow_line_box_l">
            <div class="flow_line"></div>
            <div class="flow_line"></div>
            <div class="flow_line"></div>
            <div class="flow_line"></div>
            <div class="flow_line"></div>
            <div class="flow_line"></div>
        </div>
        <p><i>OVER FLOW</i></p>
        <div class="flow_line_box_r">
            <div class="flow_line"></div>
            <div class="flow_line"></div>
            <div class="flow_line"></div>
            <div class="flow_line"></div>
            <div class="flow_line"></div>
            <div class="flow_line"></div>
        </div>
    </div>
    {{/if}}


    <div class="song {{$index < (phi ? 27 : 30) ? 'b_song':''}}">
        <div class="ill-box">
            <div class="num clip-box">
                <p name="pvis">#{{song.num}}</p>
            </div>
            <div class="ill clip-box">
                <img src="{{song.illustration}}" alt="ill">
            </div>
            <div class="rank-{{song.rank}} clip-box">
                <div class="org">
                    <p>{{song.rank}}&ensp;{{song.difficulty.toFixed(1)}}</p>
                </div>
                <div class="rel">
                    <p>{{song.rks.toFixed(2)}}</p>
                </div>
            </div>
        </div>
        <div class="info-{{song.rank}}">
            <div class="songname">
                <p name="pvis">{{song.song}}</p>
            </div>
            <div class="songinfo">
                <div class="Rating">
                    <img src="{{themeInfo && themeInfo.icons && themeInfo.icons[song.Rating] ? themeInfo.icons[song.Rating] : (_res_path + 'html/otherimg/' + song.Rating + '.png')}}" alt="{{song.Rating}}">
                </div>
                <div class="chengji">
                    <div class="score">
                        <p>{{song.score}}</p>
                    </div>
                    <div class="line"></div>
                    <div class="acc-box">
                        <div class="acc">
                            <p>{{song.acc.toFixed(2)}}%</p>
                        </div>
                        <div class="suggest suggest-kind-{{song.suggestType}}">
                            <div class="suggest-tip"></div>
                            <p>{{song.suggest}}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
            
        {{if song.accAvg}}
        <div class="accAvg acc{{song.accKind}} clip-box">
            <div class="accAvgLine clip-box"></div>
            <svg viewBox="0 0 1024 1024">
            {{if song.accKind == 'Finished'}}
            <path
            d="M892.064 261.888a31.936 31.936 0 0 0-45.216 1.472L421.664 717.248l-220.448-185.216a32 32 0 1 0-41.152 48.992l243.648 204.704a31.872 31.872 0 0 0 20.576 7.488 31.808 31.808 0 0 0 23.36-10.112L893.536 307.136a32 32 0 0 0-1.472-45.248z"
            p-id="5526"
            ></path>
            {{else}}
            <path
                d="M564.8 465.184l4.192 3.904 274.72 274.752a32 32 0 0 1 0 45.248l-22.624 22.624a32 32 0 0 1-45.248 0l-263.456-263.392-263.424 263.392a32 32 0 0 1-42.24 2.656l-3.008-2.656-22.624-22.624a32 32 0 0 1 0-45.248l274.784-274.752a80 80 0 0 1 108.96-3.904z m0-256l4.192 3.904 274.72 274.752a32 32 0 0 1 0 45.248l-22.624 22.624a32 32 0 0 1-45.248 0l-263.456-263.392-263.424 263.392a32 32 0 0 1-42.24 2.656l-3.008-2.656-22.624-22.624a32 32 0 0 1 0-45.248l274.784-274.752a80 80 0 0 1 108.96-3.904z"
                fill="#333333"
                p-id="1589"
            ></path>
            {{/if}}
            </svg>
            <p>{{song.accAvg}}</p>
        </div>
        {{/if}}
        {{if song.cpToOld}}
        <div class="cpToOld acc{{song.cpToOld.type}} clip-box-left">
            <p>Dif</p>
            <svg viewBox="0 0 1024 1024">
            <path
                d="M564.8 465.184l4.192 3.904 274.72 274.752a32 32 0 0 1 0 45.248l-22.624 22.624a32 32 0 0 1-45.248 0l-263.456-263.392-263.424 263.392a32 32 0 0 1-42.24 2.656l-3.008-2.656-22.624-22.624a32 32 0 0 1 0-45.248l274.784-274.752a80 80 0 0 1 108.96-3.904z m0-256l4.192 3.904 274.72 274.752a32 32 0 0 1 0 45.248l-22.624 22.624a32 32 0 0 1-45.248 0l-263.456-263.392-263.424 263.392a32 32 0 0 1-42.24 2.656l-3.008-2.656-22.624-22.624a32 32 0 0 1 0-45.248l274.784-274.752a80 80 0 0 1 108.96-3.904z"
                fill="#333333"
                p-id="1589"
            ></path>
            </svg>
            <p>{{song.cpToOld.dif}}&ensp;&ensp;&ensp;RKS</p>
            <svg viewBox="0 0 1024 1024">
            <path
                d="M564.8 465.184l4.192 3.904 274.72 274.752a32 32 0 0 1 0 45.248l-22.624 22.624a32 32 0 0 1-45.248 0l-263.456-263.392-263.424 263.392a32 32 0 0 1-42.24 2.656l-3.008-2.656-22.624-22.624a32 32 0 0 1 0-45.248l274.784-274.752a80 80 0 0 1 108.96-3.904z m0-256l4.192 3.904 274.72 274.752a32 32 0 0 1 0 45.248l-22.624 22.624a32 32 0 0 1-45.248 0l-263.456-263.392-263.424 263.392a32 32 0 0 1-42.24 2.656l-3.008-2.656-22.624-22.624a32 32 0 0 1 0-45.248l274.784-274.752a80 80 0 0 1 108.96-3.904z"
                fill="#333333"
                p-id="1589"
            ></path>
            </svg>
            <p>{{song.cpToOld.rks}}</p>
        </div>
        {{/if}}
    </div>

    {{/each}}

</div>
{{if b30Analysis}}
<div class="over_flow">
    <div class="flow_line_box_l">
        <div class="flow_line"></div>
        <div class="flow_line"></div>
        <div class="flow_line"></div>
        <div class="flow_line"></div>
        <div class="flow_line"></div>
        <div class="flow_line"></div>
    </div>
    <p><i>B30 数据分析</i></p>
    <div class="flow_line_box_r">
        <div class="flow_line"></div>
        <div class="flow_line"></div>
        <div class="flow_line"></div>
        <div class="flow_line"></div>
        <div class="flow_line"></div>
        <div class="flow_line"></div>
    </div>
</div>

<div class="b30-analysis-row {{if b30Analysis.histogramWide}}histogram-wide{{/if}}">
    {{if b30Analysis.showTags}}
    <section class="analysis-panel tag-analysis-panel clip-box">
        <div class="analysis-panel-head">
            <div>
                <p class="analysis-kicker">CHART PROFILE</p>
                <p class="analysis-title">谱面标签能力</p>
            </div>
            <p class="analysis-meta">有效票 {{b30Analysis.tagAnalysis ? b30Analysis.tagAnalysis.totalVotes : 0}}</p>
        </div>
        <div class="tag-analysis-body {{if !b30Analysis.tagAnalysis || b30Analysis.tagAnalysis.insufficient}}is-insufficient{{/if}}">
            <div class="tag-analysis-content">
                <div class="tag-radar-column">
                    <div class="tag-radar-title"><span></span><p>分类汇总</p></div>
                    {{if b30Analysis.tagAnalysis && b30Analysis.tagAnalysis.radar.categories.length}}
                    <svg class="tag-radar" viewBox="0 0 200 184" aria-label="分类标签能力雷达图">
                        {{each b30Analysis.tagAnalysis.radar.grids grid}}
                        <polygon class="tag-radar-grid" points="{{grid}}"></polygon>
                        {{/each}}
                        {{each b30Analysis.tagAnalysis.radar.axes axis}}
                        <line class="tag-radar-axis" x1="100" y1="92" x2="{{axis.x}}" y2="{{axis.y}}"></line>
                        {{/each}}
                        <polygon class="tag-radar-shape" points="{{b30Analysis.tagAnalysis.radar.points}}"></polygon>
                        {{each b30Analysis.tagAnalysis.radar.categories category}}
                        <circle class="tag-radar-point" cx="{{category.pointX}}" cy="{{category.pointY}}" r="2.3"></circle>
                        <text class="tag-radar-label" x="{{category.labelX}}" y="{{category.labelY}}" text-anchor="{{category.anchor}}">
                            <tspan x="{{category.labelX}}">{{category.name}}</tspan>
                            <tspan class="tag-radar-score" x="{{category.labelX}}" dy="10">{{category.displayRks}}</tspan>
                        </text>
                        {{/each}}
                    </svg>
                    {{/if}}
                </div>
                <div class="tag-ranking-column">
                    <div class="tag-ranking-group strong-tags">
                        <div class="tag-column-title"><span></span><p>擅长词条</p></div>
                        {{if b30Analysis.tagAnalysis}}
                        {{each b30Analysis.tagAnalysis.strong tag}}
                        <div class="tag-result-row">
                            <p class="tag-rank">{{$index + 1}}</p>
                            <p class="tag-name">{{tag.name}}</p>
                            <p class="tag-rks">{{tag.rks.toFixed(2)}}</p>
                        </div>
                        {{/each}}
                        {{/if}}
                    </div>
                    <div class="tag-ranking-group weak-tags">
                        <div class="tag-column-title"><span></span><p>薄弱词条</p></div>
                        {{if b30Analysis.tagAnalysis}}
                        {{each b30Analysis.tagAnalysis.weak tag}}
                        <div class="tag-result-row">
                            <p class="tag-rank">{{$index + 1}}</p>
                            <p class="tag-name">{{tag.name}}</p>
                            <p class="tag-rks">{{tag.rks.toFixed(2)}}</p>
                        </div>
                        {{/each}}
                        {{/if}}
                    </div>
                </div>
            </div>
            {{if !b30Analysis.tagAnalysis || b30Analysis.tagAnalysis.insufficient}}
            <div class="tag-insufficient-message">
                <p>可用谱面标签统计量不足，请前往 https://www.phib19.top 或使用 /settag 进行谱面标签投票</p>
            </div>
            {{/if}}
        </div>
        {{if b30Analysis.tagAnalysis && !b30Analysis.tagAnalysis.insufficient}}
        <div class="tag-analysis-tip">
            <p>当前谱面标签统计量较小，可以前往 https://www.phib19.top 或使用 /settag 指令进行投票哦！</p>
        </div>
        {{/if}}
    </section>
    {{/if}}

    <section class="analysis-panel histogram-panel clip-box">
        <div class="analysis-panel-head">
            <div>
                <p class="analysis-kicker">RKS DISTRIBUTION</p>
                <p class="analysis-title">等效 RKS 直方图</p>
            </div>
            <div class="histogram-summary">
                <p>平均 RKS</p>
                <p>{{b30Analysis.histogram.average.toFixed(4)}}</p>
            </div>
        </div>
        <div class="histogram-chart">
            <div class="histogram-y-label">等效单曲 RKS</div>
            <div class="histogram-plot">
                <div class="histogram-scale">
                    {{each b30Analysis.histogram.ticks tick}}
                    <div class="histogram-grid-line" style="bottom: {{tick.position}}%;"><p>{{tick.label}}</p></div>
                    {{/each}}
                    <div class="average-marker" style="bottom: {{b30Analysis.histogram.averagePosition}}%;"><p>AVG {{b30Analysis.histogram.average.toFixed(4)}}</p></div>
                </div>
                <div class="histogram-bars">
                    {{each b30Analysis.histogram.slots slot}}
                    <div class="histogram-slot">
                        <div class="histogram-bar-area">
                            <div class="histogram-bar {{slot.kind == 'phi' ? 'phi-bar' : 'best-bar'}}" style="height: {{slot.height}}%;"></div>
                        </div>
                        <p class="histogram-slot-label">{{slot.label}}</p>
                    </div>
                    {{/each}}
                </div>
            </div>
        </div>
        <div class="histogram-legend">
            <p><span class="legend-dot phi-dot"></span>P1-P3</p>
            <p><span class="legend-dot best-dot"></span>B1-B27</p>
            <p>{{b30Analysis.histogram.count}} 个有效槽位</p>
        </div>
    </section>
</div>
{{/if}}
<div class="createdbox">
    <div class="phi-plugin">
        <p>{{_plugin}}</p>
    </div>
    <div class="ver">
        <p>{{Version.ver}}</p>
    </div>
</div>
<div class="copyright">
    <p>*《Phi-Plugin》为非《Phigros》官方项目，与南京鸽游网络有限公司及《Phigros》官方不存在授权、合作或运营关系。
    </p>
</div>

{{if theme == "snow"}}
<div class="snow-box"> </div>
<script>
    themeSnow();
</script>
{{else if theme == "topText" || theme == "foolsDay"}}
<div class="topTextBox" id="topTextBox"></div>
<script>
    themeTopText();
</script>
{{else if theme == "star"}}
<canvas id="stars"></canvas>
<script>
    themeStar();
</script>
{{/if}}

{{/block}}
