{{extend defaultLayout}}
{{set pvis = ({
    default: false,
    '.Player_Id-right #Player_Id': [458.25, 83, 60, 20, null, { method: 'pvis', breakWords: true, useFontMetrics: !(themeInfo && themeInfo.fontUrl) }],
    '.Player_profile_box #profile': [564, 211.2, 60, 16, null, { method: 'pvis', breakWords: true, useFontMetrics: !(themeInfo && themeInfo.fontUrl) }],
    '.rankUserName': [350, 140, 35, 14, null, { method: 'pvis', breakWords: true, useFontMetrics: !(themeInfo && themeInfo.fontUrl) }]
})}}
{{block 'css'}}
    <link rel="stylesheet" href="{{_res_path}}html/userinfo/userinfo.css" />
    <link rel="stylesheet" href="{{_res_path}}html/score/score.css" />
    <link rel="stylesheet" href="{{_res_path}}html/rankingList/RankList.css" />
    {{if renderNoJs}}
    <style>
        .Player_Id-right #Player_Id, .Player_profile_box #profile, .rankUserName p { white-space: normal; overflow-wrap: anywhere; }
    </style>
    {{/if}}
{{/block}}

{{block 'main'}}

    <div class="background">
        <img
            src="{{me.backgroundurl}}"
            alt="{{me.backgroundurl}}"
        />
    </div>
    <div class="left">
        <div class="Player_Info">
            <p>PLAYER_INFO</p>
        </div>

        <div class="basic-box">
            <div class="basic-img">
                <img src="{{me.backgroundurl}}" alt="{{me.backgroundurl}}">
            </div>
            <div class="Player_Id">
                <div class="avatar">
                    <img src="{{_res_path}}html/avatar/{{me.avatar}}.png" alt="{{me.avatar}}">
                </div>
                <div class="Player_Id-box">
                    <div class="Player_Id-left">
                        <p>ID</p>
                    </div>
                    <div class="Player_Id-right">
                        <p id="Player_Id" name="pvis">{{#(me.playerId || 'NO INFO')}}</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="left_title">
            <div class="left_title-left">
                <p>PLAYER_DETAIL</p>
            </div>
        </div>
        <div class="Player_data_line">
            <div class="Player_data_line-left">
                <div class="Player_data_title" id="Player_data_left">
                    <p>RKS</p>
                </div>
                <div class="Player_data_value" id="Player_data_left">
                    <p>{{me.rks != null && typeof me.rks.toFixed == 'function' ? me.rks.toFixed(4) : '---'}}</p>
                </div>
            </div>
            <div class="Player_data_line-right">
                <div class="Player_data_title" id="Player_data_right">
                    <p>CLG MOD</p>
                </div>
                <div class="Challenge" id="Challenge2">
                    <img src="{{_res_path}}html/otherimg/{{me.ChallengeMode}}.png" alt="{{me.ChallengeMode}}">
                    <span>{{me.ChallengeModeRank}}</span>
                </div>
                <div class="Player_data_value CLG colorful" id="Player_data_right">
                    <p id="CLG">{{me.clg}}</p>
                </div>
            </div>
        </div>
        <div class="Player_data_box" id="data_box">
            <div class="Player_box_title">
                <p>DATA</p>
            </div>
            <div class="Player_box_value">
                <p id="data">{{me.data}}</p>
            </div>
        </div>
        <div class="Player_profile_box">
            <p color="white" id="profile" name="pvis">{{#(me.selfIntro || '介个人的简介被胡桃吃掉惹……').replace(/\r\n?|\n/g, '<br>')}}</p>
        </div>
        <div class="createdbox">
            <div class="phi-plugin">
                <p>{{_plugin}}</p>
            </div>
            <div class="ver">
                <p>{{Version.ver}}</p>
            </div>
        </div>
    </div>
    <div class="right">
        <div class="file-content">
            <div class="file-content-left">
                <p>SAVE_DATA</p>
            </div>
            <div class="file-content-right">
                <p>{{me.created}} ~ {{me.updated}}</p>
            </div>
        </div>
        <div class="data_title">
            <div class="data_title-left">
                <p>B30_DATA</p>
            </div>
        </div>
        <div class="b30list">
            {{each me.b30list e index}}
            <div class="b30Alist {{index}}">
                <p>{{e.title}}</p>
                {{if e.list && e.list.length}}
                <% for (var i = 0; i < e.list.length; i++) { %>
                    {{set song = e.list[i]}}
                    {{if song}}
                    <div class="ill_box">
                        <img
                            src="{{song.illustration}}"
                            alt="{{song.illustration}}"
                        />
                        <div class="b30_dif {{song.rank}}-BKG">
                            <p>{{song.rank}} {{song.difficulty.toFixed(1)}}</p>
                        </div>
                        <div class="Rating">
                            <img src="{{_res_path}}html/otherimg/{{song.Rating}}.png" alt="{{song.Rating}}">
                        </div>
                    </div>
                    {{else}}
                    <div class="ill_box">
                        <p>NO INFO</p>
                    </div>
                    {{/if}}
                <% } %>
                {{else}}
                    <div class="ill_box">
                        <p>NO INFO</p>
                    </div>
                    <div class="ill_box">
                        <p>NO INFO</p>
                    </div>
                    <div class="ill_box">
                        <p>NO INFO</p>
                    </div>
                {{/if}}

            </div>
            {{/each}}
        </div>
        <div class="data_title">
            <div class="data_title-left">
                <p>CLG_MODE_HISTORY</p>
            </div>
        </div>
        <div class="clg_data_box">
           <div class="clg_list">
                {{each me.clg_list clg}}
                <div class="a_clg_box">
                    <div class="clg_box">
                        <div class="Challenge">
                            <img src="{{_res_path}}html/otherimg/{{clg.ChallengeMode}}.png" alt="{{clg.ChallengeMode}}">
                            <p>{{clg.ChallengeModeRank}}</p>
                        </div>
                    </div>
                    <p>{{clg.date}}</p>
                </div>
                {{/each}}
            </div>
        </div>
        <div class="data_title">
            <div class="data_title-left">
                <p>RKS_HISTORY</p>
            </div>
        </div>
        <div class="svg-box">
            {{if me.rks_history?.length && me.rks_range?.length >= 2 && typeof me.rks_range[0] == 'number' && typeof me.rks_range[1] == 'number' && me.rks_date?.length >= 2}}
            <div class="value_box">
                <p>{{me.rks_range[1].toFixed(4)}}</p>
                <p>{{me.rks_range[0].toFixed(4)}}</p>
            </div>
            <div class="line-box">
                <div class="line">
                    <svg>
                        <defs>
                            <marker id="dot" viewBox="0 0 10 10" markerWidth="8" markerHeight="8" refX="2" refY="2">
                                <circle cx="2" cy="2" r="1"></circle>
                            </marker>
                        </defs>
                        {{each me.rks_history}}
                        <line x1="{{$value[0]}}%" y1="{{$value[1]}}%" x2="{{$value[2]}}%" y2="{{$value[3]}}%">
                        </line>
                        {{/each}}
                    </svg>
                </div>
                <div class="date_box">
                    <p>{{me.rks_date[0]}}</p>
                    <p>{{me.rks_date[1]}}</p>
                </div>
            </div>
            {{else}}
            <p>NO INFO</p>
            {{/if}}
        </div>
    </div>
    <div class="ranklist">
        <div class="Player_Info">
            <p>RANK_LIST</p>
        </div>
        {{each users user}}
        {{if user.backgroundurl}}
        <div class="rankUser{{user.me?' rankUserMe':''}}">
            <div class="profileIll">
                {{if !user.me}}
                <img
                    src="{{user.backgroundurl}}"
                    alt="{{user.backgroundurl}}"
                />
                {{else}}
                <img
                    src="{{me.backgroundurl}}"
                    alt="{{me.backgroundurl}}"
                />
                {{/if}}
            </div>
            <div class="ranking">
                <p>#{{user.index}}</p>
                <p>{{user.updated}}</p>
            </div>
            <div class="rankUserAvatar">
                <img src="{{_res_path}}html/avatar/{{user.avatar}}.png" alt="{{user.avatar}}" />
            </div>
            <div class="rankUserInfo">
                <div class="rankUserName">
                    <p name="pvis">{{#user.playerId}}</p>
                </div>
                <div class="rankUserRks">
                    <p>{{user.rks != null && typeof user.rks.toFixed == 'function' ? user.rks.toFixed(4) : '---'}}</p>
                </div>
                <div class="rankUserClg">
                    <div class="Challenge">
                        <img src="{{_res_path}}html/otherimg/{{user.ChallengeMode}}.png" alt="{{user.ChallengeMode}}" />
                        <span>{{user.ChallengeModeRank}}</span>
                    </div>
                </div>
            </div>
        </div>
        {{else}}
        <div class="rankUser{{user.me?' rankUserMe':''}}">
            <div class="ranking">
                <p>#{{user.index}}</p>
            </div>
            <div class="rankUserAvatar"></div>
            <div class="rankUserInfo">
                <div class="rankUserName">
                    <p name="pvis">NO INFO</p>
                </div>
            </div>
        </div>
        {{/if}}
        {{/each}}
    </div>
{{/block}}