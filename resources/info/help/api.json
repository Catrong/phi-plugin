[
    {
        "group": "查分API公测介绍",
        "list": [
            {
                "title": "查分ID",
                "eg": "",
                "desc": "您的通用查分ID，可以在任意连接查分平台的BOT处使用指令进行绑定"
            },
            {
                "title": "权限管理",
                "eg": "",
                "desc": "通过id绑定后仅能获取与查询，评论等功能需要绑定sessionToken"
            }
        ]
    },
    {
        "group": "绑定",
        "list": [
            {
                "title": "/bind",
                "eg": "/bind <userId>",
                "desc": "绑定你的 userId<br>eg1: /bind 123456"
            },
            {
                "title": "/unbind",
                "eg": "/unbind",
                "desc": "仅清除当前 Bot 本地保存的 sessionToken、API ID、存档和历史，不修改 API 平台绑定"
            }
        ]
    },
    {
        "group": "管理",
        "list": [
            {
                "title": "/tkls",
                "eg": "/tkls",
                "desc": "获取当前绑定的平台列表"
            },
            {
                "title": "/clearApiData",
                "eg": "/clearApiData",
                "desc": "永久注销 phi-api 账号并清除云端数据，需要 Phigros SSTK 权限及二次确认"
            },
            {
                "title": "/apiset",
                "eg": "/apiset",
                "desc": "设置 API 相关配置"
            }
        ]
    },
    {
        "group": "管理员命令",
        "auth": "master",
        "list": [
            {
                "title": "/updateUserToken",
                "eg": "/updateUserToken",
                "desc": "上传当前BOT端的用户 sessionToken 到API端"
            },
            {
                "title": "/updateComment",
                "eg": "/updateComment",
                "desc": "上传当前BOT端的用户评论到API端"
            }
        ]
    }
